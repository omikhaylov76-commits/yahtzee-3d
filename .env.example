# Скопируй в .env и заполни. .env в .gitignore — в репозиторий НЕ попадает.
# Секретов пока нет (БД/вход появятся в 2.3); здесь только адреса/CORS.

# --- Клиент (Vite) ---
# Публичный адрес сервера платформы. Локально можно не задавать
# (по умолчанию http://localhost:3001). Для подключения к проду — URL Railway:
#   VITE_SERVER_URL=https://<твой-сервис>.up.railway.app
VITE_SERVER_URL=

# --- Сервер ---
# Разрешённые CORS-origin клиента, через запятую (dev + прод-клиент).
# Локальный dev по умолчанию http://localhost:5173. На Railway задаётся
# переменной окружения сервиса (Variables), а не из этого файла.
CLIENT_ORIGIN=http://localhost:5173
