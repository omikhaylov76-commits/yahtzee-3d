# Скопируй в .env и заполни. .env в .gitignore — в репозиторий НЕ попадает.
# Секретов пока нет (БД/вход появятся в 2.3); здесь только адреса/CORS.

# --- Клиент (Vite) ---
# Публичный адрес сервера платформы. В ПРОДЕ клиент раздаётся тем же сервером (same-origin, 2.P) —
# оставь ПУСТЫМ, socket.io возьмёт origin страницы. Локально тоже можно не задавать (dev → по
# умолчанию http://localhost:3001). Задавай ЯВНО только если клиент и сервер на РАЗНЫХ адресах:
#   VITE_SERVER_URL=https://<твой-сервис>.up.railway.app
VITE_SERVER_URL=

# --- Сервер ---
# Разрешённые CORS-origin клиента, через запятую (dev + прод-клиент). При same-origin (клиент
# раздаётся сервером, 2.P) CORS для основного сценария не нужен, но прод-домен сюда добавить стоит
# (подстраховка). Локальный dev по умолчанию http://localhost:5173. На Railway задаётся переменной
# окружения сервиса (Variables), а не из этого файла.
CLIENT_ORIGIN=http://localhost:5173

# --- База данных (2.3) ---
# PostgreSQL. Локально (миграции/dev) — ПУБЛИЧНЫЙ адрес Railway-БД (DATABASE_PUBLIC_URL из
# переменных Postgres-сервиса). На Railway сам сервер использует ВНУТРЕННИЙ адрес (reference
# ${{Postgres.DATABASE_URL}}). Это СЕКРЕТ (с паролем) — НЕ коммить, только в .env.
DATABASE_URL=

# --- Вход через Google (2.3.b) ---
# Из Google Cloud → APIs & Services → Credentials → OAuth client (Web).
# CLIENT_ID — не секрет; SECRET — СЕКРЕТ (только .env / Railway, не в git/чат).
# REDIRECT_URI должен совпадать со строкой в настройках OAuth client.
#   локально: http://localhost:3001/auth/google/callback
#   прод:     https://yahtzee-3d-production.up.railway.app/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
